<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="926dp"
  android:background="@drawable/drawable_shape">
  
  <ImageView
    android:id="@+id/container_status_bar_light"
    android:layout_width="428dp"
    android:layout_height="45dp"
    android:layout_gravity="top|left"
    android:scaleType="centerInside"
    android:src="@drawable/container_status_bar_light" />
  
  <FrameLayout
    android:layout_width="327dp"
    android:layout_height="30dp"
    android:layout_marginLeft="-375dp"
    android:layout_marginTop="-1037dp"
    android:layout_gravity="top|left">
    
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="30dp"
      android:layout_marginRight="32dp"
      android:layout_gravity="center_horizontal"
      android:gravity="left|center_vertical"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:singleLine="true"
      android:text="Chats"
      android:textColor="#FF0F1828"
      android:textSize="18dp" />
    
    <FrameLayout
      android:layout_width="56dp"
      android:layout_height="24dp"
      android:layout_marginLeft="271dp"
      android:layout_marginTop="3dp"
      android:layout_gravity="top|left">
      
      <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|left"
        android:scaleType="centerInside"
        android:src="@drawable/drawable_image" />
      
      <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginLeft="32dp"
        android:layout_gravity="top|left"
        android:scaleType="centerInside"
        android:src="@drawable/drawable_image_phone" />
    </FrameLayout>
  </FrameLayout>
  
  <FrameLayout
    android:id="@+id/container_group"
    android:layout_width="133dp"
    android:layout_height="132dp"
    android:layout_marginRight="12.5dp"
    android:layout_marginBottom="210dp"
    android:layout_gravity="center">
    
    <FrameLayout
      android:id="@+id/container_group1"
      android:layout_width="match_parent"
      android:layout_height="100dp"
      android:layout_marginRight="16.5dp"
      android:layout_marginBottom="16dp"
      android:layout_gravity="center_vertical">
      
      <ImageView
        android:id="@+id/image_ellipse"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/image_ellipse_circle_green" />
    </FrameLayout>
    
    <ImageView
      android:id="@+id/image_ellipse1"
      android:layout_width="match_parent"
      android:layout_height="100dp"
      android:layout_marginLeft="16.5dp"
      android:layout_marginTop="16dp"
      android:layout_gravity="center_vertical"
      android:scaleType="centerCrop"
      android:src="@drawable/image_ellipse1" />
  </FrameLayout>
  
  <ImageView
    android:layout_width="30dp"
    android:layout_height="30dp"
    android:layout_marginLeft="370dp"
    android:layout_marginRight="28dp"
    android:layout_marginTop="69dp"
    android:layout_marginBottom="827dp"
    android:scaleType="centerInside"
    android:src="@drawable/drawable_image_2" />
  
  <TextView
    android:layout_width="wrap_content"
    android:layout_height="24dp"
    android:layout_marginLeft="0.5dp"
    android:layout_marginTop="398dp"
    android:layout_gravity="center_horizontal"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="How was the quality of your call?"
    android:textColor="#FFFFFFFF"
    android:textSize="16dp" />
  
  <TextView
    android:layout_width="wrap_content"
    android:layout_height="25dp"
    android:layout_marginLeft="0.5dp"
    android:layout_marginTop="350dp"
    android:layout_marginBottom="-1dp"
    android:layout_gravity="center_horizontal"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="1:02:53"
    android:textColor="#FFFFFFFF"
    android:textSize="20dp" />
  
  <FrameLayout
    android:id="@+id/container_rating"
    android:layout_width="269dp"
    android:layout_height="212dp"
    android:layout_marginLeft="82dp"
    android:layout_marginTop="446dp"
    android:layout_gravity="top|left">
    
    <ImageView
      android:id="@+id/container_rating1"
      android:layout_width="match_parent"
      android:layout_height="212dp"
      android:scaleType="centerCrop"
      android:src="@drawable/container_rating1" />
    
    <ImageView
      android:id="@+id/image_rectangle"
      android:layout_width="match_parent"
      android:layout_height="118dp"
      android:layout_marginLeft="6dp"
      android:layout_marginRight="7dp"
      android:layout_marginTop="80dp"
      android:layout_marginBottom="14dp"
      android:background="@drawable/image_rectangle_purple"
      android:scaleType="centerCrop" />
    
    <TextView
      android:id="@+id/text_write_something"
      android:layout_width="match_parent"
      android:layout_height="21dp"
      android:layout_marginLeft="25dp"
      android:layout_marginRight="79dp"
      android:layout_marginTop="102.5dp"
      android:layout_marginBottom="88.5dp"
      android:gravity="left|center_vertical"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:singleLine="true"
      android:text="write some thing...."
      android:textColor="#FF000000"
      android:textSize="16dp" />
  </FrameLayout>
</FrameLayout>
