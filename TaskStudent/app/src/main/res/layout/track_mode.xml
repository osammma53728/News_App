<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="926dp"
  android:background="@drawable/drawable_shape">
  
  <ImageView
    android:id="@+id/container_status_bar_light"
    android:layout_width="428dp"
    android:layout_height="45dp"
    android:layout_gravity="top|left"
    android:scaleType="centerInside"
    android:src="@drawable/container_status_bar_light" />
  
  <ImageView
    android:id="@+id/iv_group"
    android:layout_width="32dp"
    android:layout_height="32dp"
    android:layout_marginRight="382dp"
    android:layout_marginBottom="838dp"
    android:layout_gravity="bottom|right"
    android:scaleType="centerInside"
    android:src="@drawable/iv_group" />
  
  <ImageView
    android:layout_width="152dp"
    android:layout_height="7dp"
    android:layout_marginRight="6dp"
    android:layout_marginTop="909dp"
    android:layout_gravity="top|center_horizontal"
    android:background="@drawable/drawable_shape_1"
    android:scaleType="centerInside" />
  
  <FrameLayout
    android:id="@+id/container_frame"
    android:layout_width="185dp"
    android:layout_height="66dp"
    android:layout_marginLeft="121dp"
    android:layout_marginTop="783dp"
    android:layout_gravity="top|left">
    
    <ImageView
      android:id="@+id/image_rectangle"
      android:layout_width="185dp"
      android:layout_height="53dp"
      android:layout_marginTop="6dp"
      android:layout_gravity="top|left"
      android:background="@drawable/image_rectangle"
      android:scaleType="centerInside" />
    
    <TextView
      android:id="@+id/text_add_note"
      android:layout_width="wrap_content"
      android:layout_height="30dp"
      android:layout_marginTop="18dp"
      android:layout_marginBottom="-1dp"
      android:layout_gravity="center_horizontal"
      android:gravity="left|center_vertical"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:singleLine="true"
      android:text="Add note"
      android:textColor="#FFFFFFFF"
      android:textSize="24dp" />
  </FrameLayout>
  
  <TextView
    android:layout_width="wrap_content"
    android:layout_height="60dp"
    android:layout_marginLeft="142dp"
    android:layout_marginTop="79dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="Notes"
    android:textColor="#FF6E6AB4"
    android:textSize="40dp" />
  
  <ImageView
    android:layout_width="358dp"
    android:layout_height="54dp"
    android:layout_marginTop="185dp"
    android:layout_gravity="top|center_horizontal"
    android:background="@drawable/drawable_shape_2"
    android:scaleType="centerInside" />
  
  <ImageView
    android:layout_width="389dp"
    android:layout_height="340dp"
    android:layout_marginLeft="3.5dp"
    android:layout_marginTop="312dp"
    android:layout_gravity="top|center_horizontal"
    android:background="@drawable/drawable_shape_3"
    android:scaleType="centerInside" />
  
  <TextView
    android:layout_width="318dp"
    android:layout_height="126dp"
    android:layout_marginLeft="49dp"
    android:layout_marginTop="336dp"
    android:layout_gravity="top|left"
    android:gravity="left|top"
    android:includeFontPadding="false"
    android:lineHeight="21dp"
    android:text="Lorem ipsum dolor sit amet consectetur.\nEnim vestibulum eu donec nulla et.Lorem ipsum dolor sit amet consectetur.\nEnim vestibulum eu donec nulla et.Lorem ipsum dolor sit amet consectetur.\nEnim vestibulum eu donec nulla et."
    android:textColor="#FFFFFFFF"
    android:textSize="14dp" />
  
  <TextView
    android:layout_width="wrap_content"
    android:layout_height="24dp"
    android:layout_marginLeft="46dp"
    android:layout_marginTop="200dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="Name :"
    android:textColor="#FFFFFFFF"
    android:textSize="16dp" />
  
  <TextView
    android:layout_width="wrap_content"
    android:layout_height="24dp"
    android:layout_marginLeft="133dp"
    android:layout_marginTop="200dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="add name"
    android:textColor="#FFFFFFFF"
    android:textSize="16dp" />
  
  <ImageView
    android:layout_width="28dp"
    android:layout_height="35dp"
    android:layout_marginLeft="364dp"
    android:layout_marginRight="36dp"
    android:layout_marginTop="599dp"
    android:layout_marginBottom="292dp"
    android:scaleType="centerInside"
    android:src="@drawable/drawable_image" />
  
  <TextView
    android:layout_width="wrap_content"
    android:layout_height="21dp"
    android:layout_marginLeft="327dp"
    android:layout_marginTop="271.5dp"
    android:layout_marginBottom="-1.5dp"
    android:layout_gravity="top|left"
    android:gravity="left|center_vertical"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:singleLine="true"
    android:text="19.1.20"
    android:textColor="#FF6E6AB4"
    android:textSize="16dp" />
</FrameLayout>
