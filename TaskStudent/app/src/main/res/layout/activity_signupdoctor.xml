<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFEBEC"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/scanning_Data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Sign Up "
            android:textColor="@color/black"
            android:textSize="27sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"

            />

        <EditText
            android:id="@+id/name_editText"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:layout_margin="17dp"
            android:layout_marginTop="200dp"
            android:background="@drawable/my_corner"
            android:hint="@string/first_name_Doctor"
            android:lines="1"
            android:padding="15dp"
            android:textColor="@color/black"
            android:textColorHint="@color/black"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scanning_Data" />

        <EditText
            android:id="@+id/lastName_editText"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:layout_margin="17dp"
            android:background="@drawable/my_corner"
            android:hint="@string/second_name_Doctor"
            android:padding="15dp"
            android:textColor="@color/black"
            android:textColorHint="@color/black"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="@id/name_editText"
            app:layout_constraintStart_toStartOf="@id/name_editText"
            app:layout_constraintTop_toBottomOf="@id/name_editText"


            />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/gender"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_margin="17dp"
            android:background="@drawable/my_corner"
            android:hint="@string/gender"
            android:textColorHint="@color/black"
            app:layout_constraintEnd_toEndOf="@id/lastName_editText"
            app:layout_constraintStart_toStartOf="@id/lastName_editText"
            app:layout_constraintTop_toBottomOf="@id/password_for_email_edittxt"

            >

            <AutoCompleteTextView
                android:id="@+id/drobdown_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/my_corner"
                android:inputType="none"
                android:textColor="@color/black" />

        </com.google.android.material.textfield.TextInputLayout>


        />

        <EditText
            android:id="@+id/idNumber_editText"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:layout_margin="17dp"
            android:background="@drawable/my_corner"
            android:hint="@string/id_number"
            android:inputType="number"
            android:padding="15dp"
            android:textColor="@color/black"
            android:textColorHint="@color/black"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="@id/gender"
            app:layout_constraintStart_toStartOf="@id/gender"
            app:layout_constraintTop_toBottomOf="@id/gender"

            />

        <ImageView
            android:id="@+id/img_save_id"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginTop="7dp"
            app:layout_constraintEnd_toEndOf="@id/idNumber_editText"
            app:layout_constraintStart_toStartOf="@id/idNumber_editText"
            app:layout_constraintTop_toBottomOf="@id/idNumber_editText"
            app:srcCompat="@android:drawable/ic_menu_gallery" />

        <Button
            android:id="@+id/btn_upload_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="2dp"
            android:backgroundTint="#6E6AB4"
            android:text="@string/upload_a_photo_of_your_id"
            app:layout_constraintEnd_toEndOf="@id/idNumber_editText"
            app:layout_constraintStart_toStartOf="@id/idNumber_editText"
            app:layout_constraintTop_toBottomOf="@id/img_save_id" />


        <EditText
            android:id="@+id/username_edittxt"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:layout_margin="17dp"
            android:background="@drawable/my_corner"
            android:hint="User Name"
            android:lines="1"
            android:padding="15dp"
            android:textColor="@color/black"
            android:textColorHint="@color/black"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="@id/name_editText"
            app:layout_constraintStart_toStartOf="@id/name_editText"
            app:layout_constraintTop_toBottomOf="@id/lastName_editText"


            />


        <EditText
            android:id="@+id/password_for_email_edittxt"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:layout_margin="17dp"
            android:background="@drawable/my_corner"
            android:hint="Password"
            android:inputType="textPassword"
            android:padding="15dp"
            android:textColor="@color/black"
            android:textColorHint="@color/black"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="@id/name_editText"
            app:layout_constraintStart_toStartOf="@id/name_editText"
            app:layout_constraintTop_toBottomOf="@id/username_edittxt"


            />

        <Button
            android:id="@+id/btn_isCorrect"
            android:layout_width="match_parent"
            android:layout_height="59dp"
            android:layout_margin="17dp"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="6dp"
            android:backgroundTint="@color/white"
            android:gravity="center"
            android:text="Sigin up"
            android:textColor="#6E6AB4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/idNumber_editText"
            app:layout_constraintStart_toStartOf="@id/idNumber_editText"
            app:layout_constraintTop_toBottomOf="@id/btn_upload_id" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>