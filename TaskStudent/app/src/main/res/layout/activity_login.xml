<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFEBEC">


    <TextView
        android:id="@+id/welcome_back"
        android:layout_width="233dp"
        android:layout_height="89dp"
        android:paddingTop="50dp"
        android:text="Welcome Back!"
        android:textColor="@color/black"
        android:textSize="33dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="5dp"
        tools:ignore="MissingConstraints" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="We're so excited to see you again!"
        app:layout_constraintTop_toBottomOf="@id/welcome_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingTop="9dp"

        />

    <TextView
        android:id="@+id/username_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/user_name"
        android:textColor="@color/black"
        android:textSize="17dp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="190dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="200dp"



        />
    <TextView
        android:id="@+id/password_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/password"
        android:textColor="@color/black"
        android:textSize="17dp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="19dp"
        app:layout_constraintStart_toStartOf="@id/username_tv"
        app:layout_constraintTop_toBottomOf="@id/username_edittxt"
        android:layout_marginTop="50dp"
        tools:layout_editor_absoluteY="364dp"

        />



    <EditText
        android:id="@+id/username_edittxt"
        android:layout_width="366dp"
        android:layout_height="60dp"
        android:ems="10"
        android:background="@drawable/edit_text_bg"
        android:padding="15dp"
        android:inputType="text"
        tools:layout_editor_absoluteX="19dp"
        app:layout_constraintTop_toBottomOf="@id/username_tv"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="@id/username_tv"
        tools:layout_editor_absoluteY="247dp" />

    <EditText
        android:id="@+id/password_edit"
        android:layout_width="366dp"
        android:layout_height="60dp"
        android:ems="10"
        android:background="@drawable/edit_text_bg"
        android:padding="15dp"
        android:inputType="textPassword"
        app:layout_constraintStart_toStartOf="@id/username_edittxt"
        app:layout_constraintTop_toBottomOf="@id/password_tv"
        android:layout_marginTop="20dp"
        tools:layout_editor_absoluteX="19dp"
        tools:layout_editor_absoluteY="406dp"
        />
    <Button
        android:id="@+id/btn_forget_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="forgert your paaword?"
        android:background="@drawable/btn_nobackground"
        android:textColor="@color/darkGray"
        app:layout_constraintTop_toBottomOf="@id/password_edit"
        app:layout_constraintStart_toStartOf="@id/password_tv"
        android:paddingTop="6dp"
        />

    <Button
        android:id="@+id/login_btn"
        android:layout_width="128dp"
        android:layout_height="56dp"
        android:text="login"
        tools:layout_editor_absoluteX="141dp"
        tools:layout_editor_absoluteY="563dp"
        app:layout_constraintTop_toBottomOf="@id/password_edit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:backgroundTint="#6E6AB4"

/>


</androidx.constraintlayout.widget.ConstraintLayout>