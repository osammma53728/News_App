<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="creat a new password"
        android:textSize="33dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="40dp"
        android:id="@+id/newpass_tv"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter a new password"
        android:textSize="20dp"
        app:layout_constraintTop_toBottomOf="@id/newpass_tv"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="50dp"
        android:id="@+id/enternewpass_tv"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Password"
        app:layout_constraintTop_toBottomOf="@id/enternewpass_tv"
        app:layout_constraintStart_toStartOf="@id/enternewpass_tv"
        android:textSize="22dp"
        android:textColor="@color/black"
        android:layout_marginTop="30dp"
        android:id="@+id/password_tv"
        />
    <EditText
        android:layout_width="366dp"
        android:layout_height="60dp"
        android:background="@drawable/edit_text_bg"
        app:layout_constraintTop_toBottomOf="@id/password_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:id="@+id/newpassword_edittext"
        android:inputType="textPassword"
        android:padding="15dp"

        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="confirm password"
        app:layout_constraintTop_toBottomOf="@id/newpassword_edittext"
        app:layout_constraintStart_toStartOf="@id/enternewpass_tv"
        android:textSize="22dp"
        android:textColor="@color/black"
        android:layout_marginTop="50dp"

        android:id="@+id/confirmpass_tv"

        />
    <EditText
        android:layout_width="366dp"
        android:layout_height="60dp"
        android:background="@drawable/edit_text_bg"
        app:layout_constraintTop_toBottomOf="@id/confirmpass_tv"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        android:id="@+id/confirmpass_edittext"

        android:inputType="textPassword"
        android:padding="15dp"
        />
    <Button
        android:layout_width="150dp"
        android:layout_height="56dp"
        android:text="send"
        android:backgroundTint="#6E6AB4"
        app:layout_constraintTop_toBottomOf="@id/confirmpass_edittext"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:id="@+id/btn_sendto_confirm_new_pass"

        />
</androidx.constraintlayout.widget.ConstraintLayout>